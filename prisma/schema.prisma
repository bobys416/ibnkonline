// ============================================
// BUYMECART - Prisma Schema
// Complete database schema for the e-commerce platform
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// AUTH & USER MANAGEMENT
// ============================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   Boolean   @default(false)
  phone           String?   @unique
  phoneVerified   Boolean   @default(false)
  passwordHash    String
  fullName        String
  avatarUrl       String?
  status          UserStatus @default(PENDING_VERIFICATION)
  failedLoginAttempts Int   @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  userRoles       UserRole[]
  addresses       Address[]
  cart            Cart?
  orders          Order[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]     @relation("AuditLogUser")
  auditLogsPerformed AuditLog[]  @relation("AuditLogPerformedBy")

  @@index([email])
  @@index([phone])
  @@index([status])
  @@map("users")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model RefreshToken {
  id          String   @id @default(cuid())
  token       String   @unique
  userId      String
  expiresAt   DateTime
  revoked     Boolean  @default(false)
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  userAgent   String?
  ipAddress   String?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String   // email or phone
  token      String   @unique
  type       VerificationTokenType
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, type])
  @@index([token])
  @@map("verification_tokens")
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PHONE_OTP
}

// ============================================
// RBAC - Roles & Permissions
// ============================================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  isSystem    Boolean  @default(false) // System roles can't be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique  // e.g., "products.create", "orders.view"
  displayName String
  module      String   // e.g., "products", "orders", "users"
  description String?
  createdAt   DateTime @default(now())

  // Relations
  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ============================================
// ADDRESSES
// ============================================

model Address {
  id              String  @id @default(cuid())
  userId          String
  fullName        String
  phone           String
  addressLine1    String
  addressLine2    String?
  landmark        String?
  city            String
  state           String
  pinCode         String
  country         String  @default("India")
  addressType     AddressType @default(HOME)
  isDefault       Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@index([pinCode])
  @@map("addresses")
}

enum AddressType {
  HOME
  WORK
  OTHER
}

// ============================================
// CATEGORIES & BRANDS
// ============================================

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  metaTitle   String?
  metaDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")
  products Product[]

  @@index([parentId])
  @@index([slug])
  @@index([isActive, sortOrder])
  @@map("categories")
}

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("brands")
}

// ============================================
// PRODUCTS & VARIANTS
// ============================================

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  sku              String   @unique
  description      String?
  shortDescription String?
  categoryId       String
  brandId          String?
  
  // Pricing (stored in paise - 1 INR = 100 paise)
  mrpPaise         Int      // Maximum Retail Price
  sellingPricePaise Int     // Actual selling price
  costPricePaise   Int?     // Cost price (internal)
  
  // Tax
  taxCategory      TaxCategory @default(GST_18)
  hsnCode          String?
  
  // Product info
  weight           Float?   // in grams
  dimensionLength  Float?   // in cm
  dimensionWidth   Float?   // in cm
  dimensionHeight  Float?   // in cm
  
  // Status & workflow
  status           ProductStatus @default(DRAFT)
  rejectionReason  String?
  
  // Policies
  isReturnable     Boolean  @default(true)
  returnWindowDays Int      @default(7)
  warrantyMonths   Int?
  
  // SEO
  metaTitle        String?
  metaDescription  String?
  metaKeywords     String[]
  
  // Shipping
  isCodEligible    Boolean  @default(true)
  requiresShipping Boolean  @default(true)
  freeShipping     Boolean  @default(false)
  
  // Flags
  isFeatured       Boolean  @default(false)
  isNewArrival     Boolean  @default(false)
  isBestSeller     Boolean  @default(false)
  
  // Stats (denormalized for performance)
  avgRating        Float    @default(0)
  reviewCount      Int      @default(0)
  totalSold        Int      @default(0)
  
  createdBy        String?
  publishedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  category         Category @relation(fields: [categoryId], references: [id])
  brand            Brand?   @relation(fields: [brandId], references: [id])
  variants         ProductVariant[]
  images           ProductImage[]
  reviews          Review[]
  approvalHistory  ProductApprovalHistory[]
  wishlistItems    WishlistItem[]
  specifications   ProductSpecification[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([slug])
  @@index([sku])
  @@index([sellingPricePaise])
  @@index([avgRating])
  @@index([totalSold])
  @@index([createdAt])
  @@index([isFeatured, status])
  @@map("products")
}

enum ProductStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum TaxCategory {
  GST_0
  GST_5
  GST_12
  GST_18
  GST_28
}

model ProductVariant {
  id               String  @id @default(cuid())
  productId        String
  sku              String  @unique
  name             String  // e.g., "Blue / XL"
  
  // Variant attributes
  color            String?
  size             String?
  material         String?
  capacity         String?
  
  // Pricing override (if different from product)
  mrpPaise         Int?
  sellingPricePaise Int?
  
  // Inventory
  stockQuantity    Int     @default(0)
  reservedQuantity Int     @default(0) // Reserved during checkout
  lowStockThreshold Int    @default(5)
  
  // Status
  isActive         Boolean @default(true)
  sortOrder        Int     @default(0)
  
  weight           Float?
  imageUrl         String?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems        CartItem[]
  orderItems       OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([productId])
  @@index([sku])
  @@index([stockQuantity])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductSpecification {
  id        String @id @default(cuid())
  productId String
  key       String   // e.g., "Processor", "RAM", "Author"
  value     String
  groupName String?  // e.g., "Technical Specs", "Physical"
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_specifications")
}

model ProductApprovalHistory {
  id          String  @id @default(cuid())
  productId   String
  fromStatus  ProductStatus
  toStatus    ProductStatus
  comment     String?
  performedBy String
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_approval_history")
}

// ============================================
// INVENTORY
// ============================================

model InventoryMovement {
  id          String   @id @default(cuid())
  variantId   String
  type        InventoryMovementType
  quantity    Int      // Positive for additions, negative for deductions
  reason      String?
  referenceId String?  // Order ID, adjustment ID, etc.
  performedBy String?
  createdAt   DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId])
  @@index([type])
  @@index([createdAt])
  @@map("inventory_movements")
}

enum InventoryMovementType {
  PURCHASE         // Stock received
  SALE             // Sold to customer
  RESERVATION      // Reserved during checkout
  RESERVATION_RELEASE // Released after cancel/timeout
  RETURN           // Customer return
  ADJUSTMENT       // Manual adjustment
  DAMAGE           // Damaged stock
}

// ============================================
// CART
// ============================================

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int    @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

// ============================================
// WISHLIST
// ============================================

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

// ============================================
// ORDERS
// ============================================

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique // BMC-YYYYMMDD-XXXXX format
  userId          String
  addressId       String
  
  // Snapshot of address at time of order
  shippingName    String
  shippingPhone   String
  shippingAddress String
  shippingCity    String
  shippingState   String
  shippingPinCode String
  shippingCountry String  @default("India")
  
  // Totals (in paise)
  subtotalPaise    Int
  discountPaise    Int     @default(0)
  shippingPaise    Int     @default(0)
  taxPaise         Int     @default(0)
  totalPaise       Int
  
  // Coupon
  couponId         String?
  couponCode       String?
  
  // Status
  status           OrderStatus @default(PLACED)
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(PENDING)
  
  // Delivery
  deliveryInstructions String?
  estimatedDelivery    DateTime?
  deliveredAt          DateTime?
  
  // COD
  codAmountPaise   Int?
  codCollected     Boolean @default(false)
  codCollectedAt   DateTime?
  
  // Idempotency
  idempotencyKey   String?  @unique
  
  notes            String?
  cancelReason     String?
  cancelledAt      DateTime?
  cancelledBy      String?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User      @relation(fields: [userId], references: [id])
  address          Address   @relation(fields: [addressId], references: [id])
  coupon           Coupon?   @relation(fields: [couponId], references: [id])
  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  payments         Payment[]
  shipments        Shipment[]
  refunds          Refund[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([paymentMethod])
  @@map("orders")
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURNED
  DELIVERY_FAILED
}

enum PaymentMethod {
  ONLINE
  COD
}

enum PaymentStatus {
  PENDING
  INITIATED
  SUCCESS
  FAILED
  UNKNOWN
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
}

model OrderItem {
  id              String @id @default(cuid())
  orderId         String
  variantId       String
  
  // Immutable snapshot at purchase time
  productName     String
  variantName     String
  sku             String
  productSlug     String
  imageUrl        String?
  
  quantity        Int
  unitPricePaise  Int    // Selling price per unit at purchase time
  mrpPaise        Int    // MRP at purchase time
  discountPaise   Int    @default(0)
  taxPaise        Int    @default(0)
  totalPaise      Int    // (unitPrice * quantity) - discount + tax
  
  taxRate         Float  @default(0)
  
  // Item-level status (for partial fulfilment)
  status          OrderItemStatus @default(ACTIVE)
  
  createdAt       DateTime @default(now())

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

enum OrderItemStatus {
  ACTIVE
  CANCELLED
  RETURNED
  REFUNDED
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  comment     String?
  performedBy String?     // User ID or "system"
  createdAt   DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@map("order_status_history")
}

// ============================================
// PAYMENTS
// ============================================

model Payment {
  id                String   @id @default(cuid())
  orderId           String
  
  // Gateway info
  gatewayProvider   String   // "razorpay", "cashfree", etc.
  gatewayOrderId    String?  // Order ID from gateway
  gatewayPaymentId  String?  // Payment ID from gateway
  gatewaySignature  String?  // Signature for verification
  
  // Amount
  amountPaise       Int
  currency          String   @default("INR")
  
  // Status
  status            PaymentEventStatus @default(INITIATED)
  method            String?  // "upi", "card", "netbanking", "wallet"
  
  // Metadata
  errorCode         String?
  errorDescription  String?
  
  // Idempotency
  idempotencyKey    String?  @unique
  
  verifiedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order  Order          @relation(fields: [orderId], references: [id])
  events PaymentEvent[]

  @@index([orderId])
  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
  @@index([status])
  @@map("payments")
}

enum PaymentEventStatus {
  INITIATED
  PENDING
  AUTHORIZED
  CAPTURED
  SUCCESS
  FAILED
  UNKNOWN
  REFUND_INITIATED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
}

model PaymentEvent {
  id          String   @id @default(cuid())
  paymentId   String
  eventType   String   // "payment.authorized", "payment.captured", etc.
  status      PaymentEventStatus
  rawPayload  Json?    // Sanitized gateway response (no secrets)
  createdAt   DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([createdAt])
  @@map("payment_events")
}

model Refund {
  id                String   @id @default(cuid())
  orderId           String
  paymentId         String?
  
  amountPaise       Int
  reason            String?
  status            RefundStatus @default(PENDING)
  
  gatewayRefundId   String?
  
  requestedBy       String?  // User ID
  processedBy       String?  // Admin User ID
  processedAt       DateTime?
  
  idempotencyKey    String?  @unique
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

// ============================================
// SHIPPING
// ============================================

model Shipment {
  id              String   @id @default(cuid())
  orderId         String
  carrier         String?
  trackingNumber  String?
  trackingUrl     String?
  estimatedDelivery DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  status          ShipmentStatus @default(PENDING)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order  Order           @relation(fields: [orderId], references: [id])
  events ShipmentEvent[]

  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

model ShipmentEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  location    String?
  description String?
  timestamp   DateTime
  createdAt   DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_events")
}

// ============================================
// REVIEWS
// ============================================

model Review {
  id          String   @id @default(cuid())
  productId   String
  userId      String
  orderId     String?  // Link to the purchase order
  rating      Int      // 1-5
  title       String?
  body        String?
  isVerifiedPurchase Boolean @default(false)
  status      ReviewStatus @default(PENDING)
  moderatedBy String?
  moderatedAt DateTime?
  moderationNote String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([productId, userId]) // One review per product per user
  @@index([productId])
  @@index([userId])
  @@index([status])
  @@map("reviews")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

// ============================================
// COUPONS & PROMOTIONS
// ============================================

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  description     String?
  type            CouponType
  valuePaise      Int?     // Fixed discount in paise
  valuePercent    Float?   // Percentage discount
  minOrderPaise   Int?     // Minimum order value
  maxDiscountPaise Int?    // Max discount cap for percentage coupons
  
  usageLimit      Int?     // Total usage limit
  usagePerUser    Int      @default(1) // Per user limit
  usageCount      Int      @default(0) // Current usage count
  
  validFrom       DateTime
  validUntil      DateTime
  isActive        Boolean  @default(true)
  
  // Eligibility
  applicableCategories String[] // Category IDs, empty = all
  applicableProducts   String[] // Product IDs, empty = all
  
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  redemptions CouponRedemption[]
  orders      Order[]

  @@index([code])
  @@index([isActive, validFrom, validUntil])
  @@map("coupons")
}

enum CouponType {
  FIXED_AMOUNT
  PERCENTAGE
  FREE_SHIPPING
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])

  @@index([couponId])
  @@index([userId])
  @@map("coupon_redemptions")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  body        String
  data        Json?    // Additional structured data
  isRead      Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  deliveryAttempts NotificationDeliveryAttempt[]

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  REFUND_INITIATED
  REFUND_COMPLETED
  REVIEW_APPROVED
  ACCOUNT_VERIFIED
  PASSWORD_RESET
  PROMOTIONAL
}

model NotificationDeliveryAttempt {
  id              String   @id @default(cuid())
  notificationId  String
  channel         NotificationChannel
  status          DeliveryStatus @default(PENDING)
  errorMessage    String?
  attemptedAt     DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_delivery_attempts")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

// ============================================
// WEBHOOKS & RECONCILIATION
// ============================================

model BankingWebhookEvent {
  id            String   @id @default(cuid())
  provider      String
  eventType     String
  eventId       String   @unique // Idempotency: gateway event ID
  payload       Json
  signatureValid Boolean
  processed     Boolean  @default(false)
  processedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime @default(now())

  @@index([eventId])
  @@index([processed])
  @@index([createdAt])
  @@map("banking_webhook_events")
}

model ReconciliationRecord {
  id              String   @id @default(cuid())
  orderId         String?
  paymentId       String?
  gatewayRef      String?
  localAmountPaise Int
  gatewayAmountPaise Int?
  status          ReconciliationStatus
  discrepancy     String?
  resolvedBy      String?
  resolvedAt      DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("reconciliation_records")
}

enum ReconciliationStatus {
  MATCHED
  MISMATCHED
  PENDING
  RESOLVED
  DISPUTED
}

// ============================================
// AUDIT & SYSTEM
// ============================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?  // Who was affected
  performedBy String?  // Who performed the action
  action      String   // e.g., "user.suspended", "order.cancelled", "product.published"
  module      String   // e.g., "auth", "orders", "products"
  details     Json?    // Before/after data, additional context
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User?    @relation("AuditLogUser", fields: [userId], references: [id])
  performer   User?    @relation("AuditLogPerformedBy", fields: [performedBy], references: [id])

  @@index([userId])
  @@index([performedBy])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

model IdempotencyRecord {
  id          String   @id @default(cuid())
  key         String   @unique
  response    Json?
  statusCode  Int?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model ApplicationSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  group     String   @default("general") // "general", "shipping", "tax", "payment", etc.
  label     String?
  description String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("application_settings")
}

// ============================================
// BANNERS & CONTENT
// ============================================

model Banner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String
  linkUrl     String?
  position    String   @default("hero") // "hero", "sidebar", "category"
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([position, isActive])
  @@map("banners")
}
