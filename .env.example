# ============================================
# BUYMECART - Environment Configuration
# ============================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.

# --- Application ---
NEXT_PUBLIC_APP_NAME=Buymecart
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/buymecart?schema=public
DIRECT_URL=postgresql://postgres:your_password@localhost:5432/buymecart?schema=public

# --- Authentication ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-strong-random-secret-here-min-32-chars

# --- Delivery location ---
GEOAPIFY_API_KEY=
# Comma-separated PIN codes supported by your delivery service. Leave blank until configured.
SERVICEABLE_PIN_CODES=

# JWT Configuration
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# --- Stripe Checkout ---
# Server-side secret only. Never use a NEXT_PUBLIC_ prefix for this key.
STRIPE_SECRET_KEY=

# --- Object Storage (S3-compatible) ---
S3_ENDPOINT=https://your-s3-endpoint.com
S3_REGION=ap-south-1
S3_BUCKET=buymecart-uploads
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
NEXT_PUBLIC_CDN_URL=https://cdn.yourdomain.com

# --- Email (Resend / SMTP) ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@buymecart.com

# SMTP fallback
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# --- SMS / OTP (optional) ---
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_MAX=3

# --- Misc ---
ENCRYPTION_KEY=generate-a-32-byte-hex-key
LOG_LEVEL=debug
ENABLE_SWAGGER=true
